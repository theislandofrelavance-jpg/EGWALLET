<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Détails de la transaction"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDetailAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+0,00 €"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailTitleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titre"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailTitleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paiement - Café"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailDateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailDateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026-07-28"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailMerchantLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lieu"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailMerchantValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bistrot Central"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
